@model UniversityManagementMvc.Models.CourseAssignment


<h2>Create CourseAssignment</h2>

<form method="post">



    <label>Course Assignment Id</label>
    <input class="form-control" name="Id" value="@Model.Id" readonly />

    <label>CourseId</label>
    <input class="form-control" name="courseid" value="@Model.courseId" />


    <label>Instructor Id</label>
    <input class="form-control" name="instructorId" value="@Model.instructorId" />


    <button class="btn btn-success mt-3">Save</button>

</form>