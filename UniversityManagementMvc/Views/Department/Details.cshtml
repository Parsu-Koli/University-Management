@model UniversityManagementMvc.Models.Department

@{
    ViewData["Title"] = "Department Details";
}

<h2>Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">Department Id</dt>
        <dd class="col-sm-10">@Model.departmentId</dd>

        <dt class="col-sm-2">Department Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Budget</dt>
        <dd class="col-sm-10">@Model.Budget</dd>

        <dt class="col-sm-2">Start Date</dt>
        <dd class="col-sm-10">@Model.StartDate</dd>

        <dt class="col-sm-2">Instructor Id</dt>
        <dd class="col-sm-10">@Model.InstructorId</dd>


    </dl>
</div>

<p>
    <a asp-action="Edit" asp-route-id="@Model.departmentId" class="btn btn-secondary">Edit</a>
    <a asp-action="Index" class="btn btn-link">Back to List</a>
</p>
