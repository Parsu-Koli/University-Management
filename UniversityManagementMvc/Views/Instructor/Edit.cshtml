@model UniversityManagementMvc.Models.Instructor

<h2>Edit Instructor</h2>

<form method="post">

    <label>Id</label>
    <input class="form-control" name="Id" value="@Model.Id" readonly />

    <label>First Name</label>
    <input class="form-control" name="FirstName" value="@Model.FirstName"  />

    <label>Last Name</label>
    <input class="form-control" name="LastName" value="@Model.LastName" />

    <label>Hire Date</label>
    <input asp-for="HireDate" type="date" class="form-control" />

    <button class="btn btn-success mt-3">Update</button>
</form>
