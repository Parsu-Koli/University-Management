@model List<UniversityManagementMvc.Models.Instructor>

<h2>Instructor List</h2>

<a href="/Instructor/Create" class="btn btn-primary">Add New</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Hire Date</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.HireDate</td>
                @* <td>
                    <a asp-action="Details" class="btn btn-secondary" asp-route-id="@item.Id">Details</a>
                    <a class="btn btn-warning" href="/Instructor/Edit/@item.Id">Edit</a>
                    <a class="btn btn-danger" href="/Instructor/Delete/@item.Id">Delete</a>
                </td> *@
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
