@model UniversityManagementMvc.Models.OfficeAssignment

@{
    ViewData["Title"] = "OfficeAssigment Details";
}

<h2>Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">Instructor Id</dt>
        <dd class="col-sm-10">@Model.instructorId</dd>

        <dt class="col-sm-2">Location</dt>
        <dd class="col-sm-10">@Model.location</dd>

        
    </dl>
</div>

<p>
    <a asp-action="Edit" asp-route-id="@Model.instructorId" class="btn btn-secondary">Edit</a>
    <a asp-action="Index" class="btn btn-link">Back to List</a>
</p>
