@model UniversityManagementMvc.Models.Students

@{
    ViewData["Title"] = "Edit Student";
}

<h2>Edit</h2>

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />

    <div class="form-group mb-2">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="LastName"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="EnrollmentDate"></label>
        <input asp-for="EnrollmentDate" type="date" class="form-control" value="@Model.EnrollmentDate.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="EnrollmentDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
